<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.a6de4548.webp" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.f32e8d6f.webp" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.0d60baf6.webp" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
